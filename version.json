ents_url": "https://api.github.com/users/muthumanikandanb2005-ux/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "content_type": "application/vnd.android.package-archive", "state": "uploaded", "size": 34617225, "digest": "sha256:6c199c8f38a4f7d0817105d14a11083d8dd9ef006b65265bc954c471cd4fafa8", "download_count": 0, "created_at": "2026-10-24T14:33:03Z", "updated_at": "2026-10-24T14:33:09Z", "browser_download_url": "https://github.com/muthumanikandanb2005-ux/PulseMusic/releases/download/v3.2.2/PulseMusic-v3.2.2-x86_64.apk"}, {"url": "https://api.github.com/repos/muthumanikandanb2005-ux/PulseMusic/releases/assets/672483024", "id": 672483024, "node_id": "RA_kwDOU7jAW84oFUbQ", "name": "SHA256SUMS.txt", "label": "", "uploader": {"login": "muthumanikandanb2005-ux", "id": 226152175, "node_id": "U_kgDODXrO7w", "avatar_url": "https://avatars.githubusercontent.com/u/226152175?v=4", "gravatar_id": "", "url": "https://api.github.com/users/muthumanikandanb2005-ux", "html_url": "https://github.com/muthumanikandanb2005-ux", "followers_url": "https://api.github.com/users/muthumanikandanb2005-ux/followers", "following_url": "https://api.github.com/users/muthumanikandanb2005-ux/following{/other_user}", "gists_url": "https://api.github.com/users/muthumanikandanb2005-ux/gists{/gist_id}", "starred_url": "https://api.github.com/users/muthumanikandanb2005-ux/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/muthumanikandanb2005-ux/subscriptions", "organizations_url": "https://api.github.com/users/muthumanikandanb2005-ux/orgs", "repos_url": "https://api.github.com/users/muthumanikandanb2005-ux/repos", "events_url": "https://api.github.com/users/muthumanikandanb2005-ux/events{/privacy}", "received_events_url": "https://api.github.com/users/muthumanikandanb2005-ux/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "content_type": "text/plain; charset=utf-8", "state": "uploaded", "size": 395, "digest": "sha256:fc55a0227f1e2f1d6b029c934f81a6f286e4c519aa2474cba1576e8a0c088f0e", "download_count": 0, "created_at": "2026-10-24T14:33:03Z", "updated_at": "2026-10-24T14:33:03Z", "browser_download_url": "https://github.com/muthumanikandanb2005-ux/PulseMusic/releases/download/v3.2.2/SHA256SUMS.txt"}], "tarball_url": "https://api.github.com/repos/muthumanikandanb2005-ux/PulseMusic/tarball/v3.2.2", "zipball_url": "https://api.github.com/repos/muthumanikandanb2005-ux/PulseMusic/zipball/v3.2.2", "body": "## Pulse Music v3.2.2 (Dolby Atmos Hardware Gating, High-Fidelity DSP & Pastel Aesthetics)\r\n\r\n### ðŸŽ§ Dolby Atmos Hardware Detection & Platform Spatialization\r\n- **Strict Hardware Verification**: Dolby Atmos now activates ONLY on verified supported hardware through 5 independent checks (AudioEffect DAP UUIDs, Android 12L+ Spatializer API, MediaCodec E-AC-3 JOC / AC-4 decoders, AudioDeviceInfo multi-channel encodings, and OEM system properties).\r\n- **Graceful Unsupported State**: Unsupported devices now clearly show a disabled state with subtitle: *\"Dolby Atmos is not supported on this device\"*.\r\n- **Android Spatializer Integration**: Audio attributes now declare `SPATIALIZATION_BEHAVIOR_AUTO`, allowing compatible spatial audio headphones to receive multi-dimensional spatial soundstage output.\r\n\r\n### ðŸ”Š High-Definition Audiophile DSP Engine Overhaul\r\n- **Zero Phase Delay**: Synchronous 16-bit PCM stereo pair processing eliminates the 1-sample interchannel phase delay, restoring crystal-clear vocal imaging, solid center phantom staging, and removing comb filtering.\r\n- **Head-Shadow Acoustic Diffraction**: 1st-order low-pass filter (~4.0 kHz) on the crossfeed signal simulates true-to-life human acoustic head diffraction (HRTF) without harsh high-frequency treble phase artifacts.\r\n- **Transparent Dynamic Headroom & Peak Limiter**: -1.0 dB pre-attenuation headroom + cubic soft-knee limiting engaged strictly above 31,000 (95% full scale, -0.48 dBFS), ending premature -2.7 dBFS saturation and delivering uncompressed, punchy, dynamic audio.\r\n- **Audiophile Profile Tuning**: Refined acoustic curves for Dynamic (+1.8 dB @ 55 Hz, +1.6 dB @ 12 kHz), Music (+1.8 dB @ 50 Hz, flat transparent mids, +1.5 dB @ 13.5 kHz), Cinema (+3.0 dB @ 45 Hz, +2.2 dB @ 2.4 kHz dialogue clarity), and Voice.\r\n\r\n### ðŸŽ¨ Soft Pastel Settings Aesthetics\r\n- **Pastel Lavender Switches**: Removed harsh neon-green toggles; replaced with a cohesive soft pastel lavender palette (`#A78BFA` track, pure white thumb, `#27272A` neutral dark track when off).\r\n\r\n### âš¡ Player Metadata Sync & Listen Together Hardening\r\n- **Instant Skip Metadata & Device Badge**: Synchronous album art and title updating across song skips with real-time active output device detection (Bluetooth, phone speaker, USB/headset).\r\n- **Listen Together Threading**: Thread-safe Main-dispatcher operations for ExoPlayer position reporting and buffer synchronization.\r\n"}