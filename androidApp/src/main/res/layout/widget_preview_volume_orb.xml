<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/widget_pill_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_orb_side"
        android:contentDescription="@null"
        android:padding="7dp"
        android:src="@drawable/round_volume_down_24"
        android:tint="#FFFFFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pulse Orb"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sound Track • Playing"
            android:textColor="#22C55E"
            android:textSize="10sp"
            android:singleLine="true" />
    </LinearLayout>

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_orb_center"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/rounded_play_arrow_24"
        android:tint="#000000" />

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_orb_side"
        android:contentDescription="@null"
        android:padding="7dp"
        android:src="@drawable/round_volume_up_24"
        android:tint="#FFFFFF" />
</LinearLayout>
