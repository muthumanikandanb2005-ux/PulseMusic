<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/widget_pill_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_preview_circle"
        android:contentDescription="@null"
        android:src="@drawable/round_music_note_24"
        android:tint="#FFFFFF"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pulse Music"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Now Playing • Expressive"
            android:textColor="#A0A0A5"
            android:textSize="10sp"
            android:singleLine="true" />
    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/rounded_fast_rewind_24"
        android:tint="#B0B0B8" />

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginHorizontal="6dp"
        android:background="@drawable/widget_play_disc"
        android:contentDescription="@null"
        android:padding="6dp"
        android:src="@drawable/rounded_play_arrow_24" />

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/rounded_fast_forward_24"
        android:tint="#B0B0B8" />
</LinearLayout>
