<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/widget_pill_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_preview_circle"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/round_groups_24"
            android:tint="#38BDF8" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_preview_circle"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/round_music_note_24"
            android:tint="#A788FA" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_preview_circle"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/round_headphones_24"
            android:tint="#FBBF24" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginHorizontal="10dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView android:layout_width="2dp" android:layout_height="8dp" android:background="@drawable/widget_preview_line" android:contentDescription="@null" />
        <ImageView android:layout_width="2dp" android:layout_height="14dp" android:layout_marginStart="2dp" android:background="@drawable/widget_preview_line" android:contentDescription="@null" />
        <ImageView android:layout_width="2dp" android:layout_height="18dp" android:layout_marginStart="2dp" android:background="@drawable/widget_preview_line" android:contentDescription="@null" />
        <ImageView android:layout_width="2dp" android:layout_height="10dp" android:layout_marginStart="2dp" android:background="@drawable/widget_preview_line" android:contentDescription="@null" />
        <ImageView android:layout_width="2dp" android:layout_height="16dp" android:layout_marginStart="2dp" android:background="@drawable/widget_preview_line" android:contentDescription="@null" />
        <ImageView android:layout_width="2dp" android:layout_height="12dp" android:layout_marginStart="2dp" android:background="@drawable/widget_preview_line" android:contentDescription="@null" />
        <ImageView android:layout_width="2dp" android:layout_height="6dp" android:layout_marginStart="2dp" android:background="@drawable/widget_preview_line" android:contentDescription="@null" />
    </LinearLayout>

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/widget_circle_button"
        android:contentDescription="@null"
        android:padding="6dp"
        android:src="@drawable/round_groups_24"
        android:tint="#000000" />
</LinearLayout>
